{
  "name": "petrolenz-qaqc-desktop",
  "productName": "DocCheck AI",
  "version": "1.0.0",
  "private": true,
  "description": "DocCheck AI desktop app",
  "author": "DocCheck AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:client": "npm --prefix ../client run build -- --base ./ --outDir ../desktop/renderer --emptyOutDir",
    "build": "npm run build:client && electron-builder --win nsis",
    "build:portable": "npm run build:client && electron-builder --win portable",
    "build:dir": "npm run build:client && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^36.9.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.doccheck.desktop",
    "productName": "DocCheck AI",
    "copyright": "Copyright © DocCheck AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/splash.mp4",
        "to": "splash.mp4"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "DocCheck-AI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocCheck AI"
    }
  }
}
