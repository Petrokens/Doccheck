# Groq (OpenAI-compatible API). If set, Groq is used instead of OpenAI.
GROQ_API_KEY=
# Optional; see https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# Used when the user uploads an image in checklist chat
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# QC checklist-review: keep under Groq free-tier TPM (try 2800–3500 if you still hit limits)
QC_MAX_DOC_CHARS=3200
QC_MAX_OUTPUT_TOKENS=4096
QC_MIN_QUESTIONS=22

# OpenAI (used only when GROQ_API_KEY is unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4
