NODE_ENV=development
PORT=5000
PG_SSL=false

# Dedicated QA/QC database — never reuse another product database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/petrolenz_qaqc

# Comma-separated browser origins. Required. Do not leave empty.
FRONTEND_URL=http://localhost:5174

# Random 32+ character secrets. Access and refresh MUST differ.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Cookie SameSite: lax (recommended) | strict | none (cross-site only, requires HTTPS)
REFRESH_COOKIE_SAME_SITE=lax

# Optional. Development defaults to 127.0.0.1. Use 0.0.0.0 only on a controlled test LAN.
BIND_HOST=127.0.0.1

# Set true only if the database requires TLS without a trusted CA.
PG_SSL_INSECURE=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MASTER_EMAIL=admin@petrolenz.local
MASTER_PASSWORD=
MASTER_USERNAME=Master User

EMAIL_USER=
EMAIL_PASS=

# Never enable these in production
AUTH_ALLOW_PUBLIC_REGISTER=false
ALLOW_DEMO_REPORTS=0
EXTRACTION_CONCURRENCY=4
