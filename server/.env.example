NODE_ENV=development
PORT=5000
PG_SSL=true
PG_SSL_INSECURE=true

# Supabase: use Session pooler (IPv4). Direct db.PROJECT.supabase.co is IPv6-only.
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated browser origins. Required. Do not leave empty.
FRONTEND_URL=http://localhost:5174

# Random 32+ character secrets. Access and refresh MUST differ.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Cookie SameSite: lax (recommended) | strict | none (cross-site only, requires HTTPS)
REFRESH_COOKIE_SAME_SITE=lax

# Optional. Development defaults to 127.0.0.1. Use 0.0.0.0 only on a controlled test LAN.
BIND_HOST=127.0.0.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MASTER_EMAIL=admin@petrolenz.com
MASTER_PASSWORD=
MASTER_USERNAME=Master User

# SMTP only — login credentials, OTP codes, and password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Petrolenz QA/QC <noreply@yourdomain.com>

# Never enable these in production
AUTH_ALLOW_PUBLIC_REGISTER=false
ALLOW_DEMO_REPORTS=0
EXTRACTION_CONCURRENCY=4

# Interactive OpenAPI UI at /api/docs (on by default outside production)
ENABLE_SWAGGER=true
