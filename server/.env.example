NODE_ENV=development
PORT=5000
PG_SSL=true
PG_SSL_INSECURE=true

# Supabase: use Session pooler (IPv4). Direct db.PROJECT.supabase.co is IPv6-only.
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated browser origins. Desktop EXE uses http://127.0.0.1:19200
FRONTEND_URL=https://your-doccheck-host.onrender.com,http://127.0.0.1:19200

# Random 32+ character secrets. Access and refresh MUST differ.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Desktop EXE → Render HTTPS API requires SameSite=none
REFRESH_COOKIE_SAME_SITE=none

# Local only. On Render leave UNSET. Never set 127.0.0.1 on Render.
# BIND_HOST=127.0.0.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MASTER_EMAIL=admin@doccheck.com
MASTER_PASSWORD=
MASTER_USERNAME=Master User

# SMTP only — login credentials, OTP codes, and password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DocCheck AI <noreply@yourdomain.com>

# Never enable public register in production
AUTH_ALLOW_PUBLIC_REGISTER=false
# Login OTP via SMTP. Set AUTH_REQUIRE_OTP=true after SMTP_* is filled in.
AUTH_SKIP_OTP=true
AUTH_REQUIRE_OTP=false
ALLOW_DEMO_REPORTS=0
EXTRACTION_CONCURRENCY=4

# Advanced OCR / image analysis
# hybrid = native text + raster OCR on weak/scanned pages (recommended)
# full = OCR every page (use this to force PaddleOCR on image-heavy text PDFs)
# native = embedded text only
OCR_MODE=hybrid
# Raster OCR engine: auto (PaddleOCR if service up, else Tesseract) | paddle | tesseract
OCR_ENGINE=auto
ENABLE_PADDLEOCR=true
PADDLEOCR_URL=http://127.0.0.1:8866
PADDLEOCR_TIMEOUT_MS=120000
# 0 = read every page (recommended). Set a number only if you need a hard cap.
OCR_MAX_PAGES=0
OCR_RENDER_SCALE=2.2
OCR_CONCURRENCY=2
OCR_WEAK_PAGE_CHARS=120
ENABLE_VISION_ANALYSIS=true
VISION_WEAK_PAGE_CHARS=80
OPENAI_VISION_MODEL=gpt-4o-mini
# Max characters of extracted document text sent to the report engine (all pages still included)
AI_DOC_CHAR_BUDGET=800000

# Interactive OpenAPI UI at /api/docs (on by default outside production)
ENABLE_SWAGGER=true

# Latest app version advertised to desktop/web clients. Bump this when you ship an update.
# Old installers (lower version) show a center popup to update.
APP_VERSION=1.1.0
# APP_FORCE_UPDATE=1
# APP_UPDATE_MESSAGE=Please install the latest DocCheck AI desktop build.
# APP_UPDATE_URL=
